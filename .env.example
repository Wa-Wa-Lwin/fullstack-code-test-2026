# Copy to .env (git ignores it) and fill in the 2C2P sandbox credentials.
# docker compose reads this file for the api service.
TWOC2P_MERCHANT_ID=
TWOC2P_SECRET_KEY=

# Where 2C2P posts payment notifications. It must be reachable from the internet,
# e.g. an ngrok or Cloudflare Tunnel URL pointing at port 8080:
# TWOC2P_BACKEND_RETURN_URL=https://<your-tunnel>/api/payments/2c2p/notification
TWOC2P_BACKEND_RETURN_URL=http://localhost:8080/api/payments/2c2p/notification
