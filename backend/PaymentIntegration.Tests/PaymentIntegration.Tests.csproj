<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- The integration tests start real MySQL and Redis containers, so Docker must be running. -->
    <PackageReference Include="Testcontainers.MySql" Version="4.17.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaymentIntegration.Api\PaymentIntegration.Api.csproj" />
    <ProjectReference Include="..\PaymentIntegration.Application\PaymentIntegration.Application.csproj" />
    <ProjectReference Include="..\PaymentIntegration.Infrastructure\PaymentIntegration.Infrastructure.csproj" />
  </ItemGroup>

</Project>
